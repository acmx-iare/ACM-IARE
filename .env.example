# ACM IARE - Environment Configuration Template
# Copy this file to .env.local for local development

# Site Base URL
NEXT_PUBLIC_SITE_URL=https://acm.iare.ac.in

# Google Apps Script & Google Sheets Automation
# URL of your deployed Google Apps Script Web App (https://script.google.com/macros/s/.../exec)
GOOGLE_APPS_SCRIPT_URL=
# Secure Secret API key (set in Apps Script Project Settings -> Script Properties as API_KEY)
GOOGLE_APPS_SCRIPT_API_KEY=

# Administrator Console Access Password
ADMIN_PASSWORD=

# Neon PostgreSQL Database
# Format: postgresql://[user]:[password]@[endpoint-pooler].[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# Cloudflare R2 Object Storage (Bucket: acm-iare-files)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=acm-iare-files
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Optional custom public domain or CDN URL for R2 bucket (if configured)
R2_PUBLIC_URL=

# Application Base URL (for reset password links)
APP_BASE_URL=https://acm.iare.ac.in

# Password Recovery & Administrative Email Delivery (SMTP)
# Designated administrator recovery email: acmiare@gmail.com
EMAIL_FROM="ACM IARE Student Chapter <acmiare@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=acmiare@gmail.com
SMTP_PASS=your-google-app-password
